 "Nmm_reg": "K := [2000[N/mm], 1000[N]; 1000[N], 3000000[N*mm]]\nG := [1[1/mm], 0.1; 0.1, 200[mm]]\nl := eigenvals(K, G)\n",
 "bad_units": "K := [2[kN/m], 1[kN]; 1[kN], 3[kN*m]]\nG := [1[1/m], 0.1[m]; 0.1[m], 0.2[m]]\nl := eigenvals(K, G)\n",
